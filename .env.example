OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
COINGECKO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Comma-separated recipients
EMAIL_TO=
# Only needed for the local Gmail relay. Use a Google app password, not your login password.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Optional weekly Google Drive uploads: separate OAuth authorization, not a Gmail app password.
GOOGLE_DRIVE_ACCOUNT=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# V1.2 adds no required environment variables. Existing OPENAI_* settings are reused.
# No production social adapter is installed. Keep v12.social.provider: none.
# A future provider adapter must read credentials from environment variables,
# not config.yaml or persisted social metadata. Fixture providers are tests only.
